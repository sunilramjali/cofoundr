# CoFoundr environment variables. Copy .env.example to .env and fill in.
# NEVER commit .env.

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=cofoundr-db

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon

# Voyage AI (embeddings / reranking, if not using Atlas Automated Embedding)
VOYAGE_API_KEY=

# WhatsApp via Twilio (sandbox: Console → Messaging → Try it out → Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# the legacy sandbox number (+14155238886); the newer trial sandbox number can't send free text
TWILIO_WHATSAPP_FROM=
# the owner's phone (the one that joined the sandbox); only this number is acted on
OWNER_WHATSAPP=

# Treg (agent tool gateway)
TREG_API_KEY=

# Events data
TICKETMASTER_API_KEY=

# FastAPI bridge: secret token for the read-only /brief URL
BRIEF_TOKEN=

# Gmail autonomous invoice intake (dedicated demo inbox, IMAP + app password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# TfL Unified API (optional: works without a key at low volume)
TFL_APP_KEY=

# Card payments (read-only). Sandbox data counts as synthetic; production = real data, needs a non-demo MONGODB_DB
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=sandbox
SQUARE_LOCATION_ID=
SUMUP_ACCESS_TOKEN=
SUMUP_ENV=sandbox
# Secret salt for hashing card providers' transaction ids (required for real data; never change it after importing)
PAYMENT_ID_SALT=
# "off" drops the explicit Argon thinking level (the model default), e.g. if replies get too slow
GEMINI_THINKING=
