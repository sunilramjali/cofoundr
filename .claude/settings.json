{
  "permissions": {
    "ask": [
      "Edit(**/.claude/CLAUDE.md)",
      "Edit(**/.claude/MVP.md)",
      "Edit(**/.claude/project-plan.md)",
      "Edit(**/.claude/winning-criteria.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shared-doc-warning.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sync-check.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
